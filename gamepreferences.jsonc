// Player preferences 100-199. Applied client-side for optional UX.
{
  "100": {
    "name": "Animation speed",
    "needReload": false,
    "values": {
      "0": { "name": "Off", "cssPref": "bae_anim_off" },
      "1": { "name": "Slow", "cssPref": "bae_anim_slow" },
      "2": { "name": "Normal", "cssPref": "bae_anim_normal" },
      "3": { "name": "Fast", "cssPref": "bae_anim_fast" }
    },
    "default": 2
  },
  "101": {
    "name": "Action previews",
    "needReload": false,
    "values": {
      "0": { "name": "Disabled", "cssPref": "bae_previews_off" },
      "1": { "name": "Enabled", "cssPref": "bae_previews_on" }
    },
    "default": 1
  },
  "103": {
    "name": "Sound effects",
    "needReload": false,
    "values": {
      "0": { "name": "Off", "cssPref": "bae_sound_off" },
      "1": { "name": "On", "cssPref": "bae_sound_on" }
    },
    "default": 1
  },
  "104": {
    "name": "Show zoom controls",
    "needReload": false,
    "values": {
      "0": {
        "name": "Disabled",
        "description": "The table stays fitted to the screen. Browser zoom still enlarges the page.",
        "cssPref": "bae_zoom_off"
      },
      "1": {
        "name": "Enabled",
        "description": "Shows zoom out, zoom in, and reset on the table.",
        "cssPref": "bae_zoom_on"
      }
    },
    "default": 0
  },
  "105": {
    "name": "Image resolution",
    "needReload": false,
    "values": {
      "0": {
        "name": "Full",
        "description": "Cards and player boards use the sharpest image that fits their size on screen."
      },
      "1": {
        "name": "Half",
        "description": "Caps cards and player boards at half resolution. A smaller on-screen size still uses a lower image. This can improve performance on low-end devices."
      },
      "2": {
        "name": "Quarter",
        "description": "Caps cards and player boards at quarter resolution. This can improve performance on low-end devices."
      }
    },
    "default": 0
  }
}
