{
  "$comment": "Player preferences 100-199. Applied client-side for optional UX.",
  "100": {
    "name": "Animation speed",
    "needReload": false,
    "values": {
      "0": { "name": "Off", "cssPref": "bae_anim_off" },
      "1": { "name": "Slow", "cssPref": "bae_anim_slow" },
      "2": { "name": "Normal", "cssPref": "bae_anim_normal" },
      "3": { "name": "Fast", "cssPref": "bae_anim_fast" }
    },
    "default": 2
  },
  "101": {
    "name": "Action previews",
    "needReload": false,
    "values": {
      "0": { "name": "Disabled", "cssPref": "bae_previews_off" },
      "1": { "name": "Enabled", "cssPref": "bae_previews_on" }
    },
    "default": 1
  },
  "102": {
    "name": "Confirmation dialogs",
    "needReload": false,
    "values": {
      "0": { "name": "Skip when safe", "cssPref": "bae_confirm_skip" },
      "1": { "name": "Always ask", "cssPref": "bae_confirm_always" }
    },
    "default": 1
  },
  "103": {
    "name": "Sound effects",
    "needReload": false,
    "values": {
      "0": { "name": "Off", "cssPref": "bae_sound_off" },
      "1": { "name": "On", "cssPref": "bae_sound_on" }
    },
    "default": 1
  }
}
